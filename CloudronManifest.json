  "upstreamLicense": {
    "name": "BSD-3-Clause",
    "url": "https://github.com/juanfont/headscale/blob/v0.29.7/LICENSE"
  },
  "minBoxVersion": "9.1.0",
  "memoryLimit": 268435456,
  "optionalSso": true,
  "addons": {
    "localstorage": {},
    "oidc": {
      "loginRedirectUri": "/oidc/callback"
    }
  },
  "udpPorts": {
    "STUN_PORT": {
      "title": "STUN (NAT traversal)",
      "description": "UDP port for the embedded DERP relay's STUN service. Disabling it also disables the embedded relay; devices then use Tailscale's public relays. Avoid 3478 (Cloudron TURN) and ports other apps use.",
      "defaultValue": 3480
    }
  },
